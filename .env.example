# 使用哪一家的 ai (openai / gemini / nvidia / claude / codex)
AI_PROVIDER=
# ai 模型
AI_MODEL=
# ai base url
AI_BASE_URL=
# gemini api key
GEMINI_API_KEY=
# openai api key
OPENAI_API_KEY=
# nvidia api key
NVIDIA_API_KEY=
# claude api key
CLAUDE_API_KEY=
# codex api key
CODEX_API_KEY=
# Slack Bot api token
SLACK_API_TOKEN=
# Slack 頻道 id
SLACK_CHANNEL_ID=
# 「美股即時進場價格」頻道：原股雷達與現貨 rToken 雷達共用，禁止 fallback 到一般頻道。
US_STOCK_SLACK_CHANNEL_ID=
# 美股現貨 rToken 自動行情／訊號通知開關；不代表自動下單授權。
STOCK_TOKEN_RADAR_ENABLED=true
# 加密 key 
MASTER_ENCRYPTION_KEY=
# 邀請碼
INVITATION_CODE=
